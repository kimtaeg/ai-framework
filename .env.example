# 학습 도우미 챗봇용 설정. 이 파일을 복사해서 .env 로 저장하고 키를 넣으세요.
# .env 는 개발 서버가 브라우저에 보여주지 않도록 막혀 있습니다. 키를 코드나 다른 파일에 적지 마세요.
GEMINI_API_KEY=
# 선택: 사용할 모델 (기본 gemini-flash-lite-latest)
# GEMINI_MODEL=gemini-flash-lite-latest
# 선택: 기본 모델이 바쁠 때 대신 쓸 모델 (쉼표로 구분)
# GEMINI_FALLBACK_MODELS=gemini-flash-latest

# 선택: 개발 서버의 포트와 주소 (기본 5200, 모든 주소)
# PORT=5200
# HOST=127.0.0.1
# 선택: /api/sql · /api/redis · /api/demo 를 다른 컴퓨터에서도 쓰게 하려면 1 (기본은 같은 컴퓨터만 허용)
# ALLOW_REMOTE_API=1
